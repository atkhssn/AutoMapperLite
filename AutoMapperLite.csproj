<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net6.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>

		<!-- NuGet Metadata -->
		<PackageId>AutoMapperLite</PackageId>
		<Version>4.0.1</Version>
		<PackageReleaseNotes>
			AutoMapperLite 4.0.1 — current official release; all prior versions (3.x and
			earlier) are deprecated.

			• Official project website: https://automapperlite.atkhssn.info
			• New visual identity (icon, favicons, app icons, social preview images)
			• Full XML documentation included for the public API (IntelliSense support)
			• Carries forward every 3.0.x fix: struct-destination mapping, nested
			  List&lt;T&gt; property auto-mapping, multi-ForPath application, DI/config
			  thread-safety, and the mapping-hot-path performance work (~3.3-4x faster,
			  ~6.5-8x less allocation per map versus 3.0.1, measured via the repo's
			  BenchmarkDotNet suite)
			• No public API breaking changes since 3.0.3
		</PackageReleaseNotes>
		<Authors>Atik Hassan</Authors>
		<Company>AutoMapperLite</Company>
		<Description>AutoMapperLite is a lightweight, reflection-based object-to-object mapper for .NET — a small, dependency-minimal alternative to AutoMapper for mapping DTOs and entities. Targets net6.0 through net10.0. Features fluent CreateMap/ForMember/ForPath profiles, nested object and List&lt;T&gt; collection mapping, thread-safe configuration, and singleton-friendly dependency injection via AddAutoMapperLite. Built for projects that want simple, fast, low-allocation object mapping without a large dependency footprint. Official site: https://automapperlite.atkhssn.info</Description>
		<PackageTags>mapper;object mapper;object mapping;dto mapper;dto mapping;automapper alternative;mapster alternative;dotnet mapper;csharp mapper;lightweight mapper;reflection mapper</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://automapperlite.atkhssn.info</PackageProjectUrl>
		<RepositoryUrl>https://github.com/atkhssn/AutoMapperLite</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<Copyright>© 2025-2026 Atik Hassan</Copyright>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>icon.png</PackageIcon>
	</PropertyGroup>

	<ItemGroup>
		<!-- Files to include in NuGet -->
		<None Include="README.md" Pack="true" PackagePath="" />
		<None Include="LICENSE" Pack="true" PackagePath="" />
		<None Include="icon.png" Pack="true" PackagePath="" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="AutoMapperLite.Tests" />
	</ItemGroup>

	<ItemGroup>
		<Compile Remove="AutoMapperLite.Tests\**" />
		<Compile Remove="AutoMapperLite.Benchmarks\**" />
		<EmbeddedResource Remove="AutoMapperLite.Tests\**" />
		<EmbeddedResource Remove="AutoMapperLite.Benchmarks\**" />
		<None Remove="AutoMapperLite.Tests\**" />
		<None Remove="AutoMapperLite.Benchmarks\**" />
	</ItemGroup>

</Project>