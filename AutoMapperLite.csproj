<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net6.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>

		<!-- Microsoft.Extensions.DependencyInjection.Abstractions 10.0.11 declares net6.0/net7.0
		     as "not tested" (both are EOL runtimes) but its assembly is netstandard2.0-compatible
		     and functions correctly there: verified via an actual runtime smoke test (DI container
		     built, AddAutoMapperLite resolved, a real Map<T> call executed and asserted) on net6.0,
		     not just assumed. Suppressed as a known-benign policy warning, not a real break. -->
		<SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>

		<!-- NuGet Metadata -->
		<PackageId>AutoMapperLite</PackageId>
		<Version>4.0.2</Version>
		<PackageReleaseNotes>
			AutoMapperLite 4.0.2 — current official release; all prior versions are deprecated.

			• Fixed: updated test tooling (xunit.v3, Microsoft.NET.Test.Sdk 18.9.0) hard-required
			  net8.0+ and a Microsoft Testing Platform v2 change dropped dotnet test's legacy
			  VSTest bridge on the .NET 10 SDK — the test project now targets net8.0-net10.0 (the
			  library itself is unaffected and still targets net6.0-net10.0) and a repo-root
			  global.json opts dotnet test into native MTP mode
			• Fixed: Activator.CreateInstance failures (e.g. mapping to a positional record with
			  no parameterless constructor) now throw a clear InvalidOperationException naming
			  the type, instead of a bare MissingMethodException
			• Added real, measured BenchmarkDotNet comparisons against manual mapping, AutoMapper
			  16.2.0, and Mapster 10.0.12 — published in docs/performance.html; AutoMapperLite is
			  not the fastest of the four, and the docs/package description no longer claim
			  otherwise
			• Verified and documented several previously-untested behaviors: null source
			  properties are skipped (not assigned), auto-map requires an exact type match
			  (different enum types / numeric widening are not converted), and records with a
			  parameterless constructor + init-only properties map correctly
			• No public API breaking changes since 3.0.3
		</PackageReleaseNotes>
		<Authors>Atik Hassan</Authors>
		<Company>AutoMapperLite</Company>
		<Description>AutoMapperLite is a lightweight, reflection-based object-to-object mapper for .NET — a small, dependency-minimal alternative to AutoMapper for mapping DTOs and entities. Targets net6.0 through net10.0. Features fluent CreateMap/ForMember/ForPath profiles, nested object and List&lt;T&gt; collection mapping, thread-safe configuration, and singleton-friendly dependency injection via AddAutoMapperLite. Built for projects that want a simple, dependency-minimal mapper without a large footprint; see the published benchmarks for how its reflection-based approach compares to compiled-expression mappers. Official site: https://automapperlite.atkhssn.info</Description>
		<PackageTags>mapper;object mapper;object mapping;dto mapper;dto mapping;automapper alternative;mapster alternative;dotnet mapper;csharp mapper;lightweight mapper;reflection mapper</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://automapperlite.atkhssn.info</PackageProjectUrl>
		<RepositoryUrl>https://github.com/atkhssn/AutoMapperLite</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<Copyright>© 2025-2026 Atik Hassan</Copyright>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>icon.png</PackageIcon>
	</PropertyGroup>

	<ItemGroup>
		<!-- Files to include in NuGet -->
		<None Include="README.md" Pack="true" PackagePath="" />
		<None Include="LICENSE" Pack="true" PackagePath="" />
		<None Include="icon.png" Pack="true" PackagePath="" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="AutoMapperLite.Tests" />
	</ItemGroup>

	<ItemGroup>
		<Compile Remove="AutoMapperLite.Tests\**" />
		<Compile Remove="AutoMapperLite.Benchmarks\**" />
		<EmbeddedResource Remove="AutoMapperLite.Tests\**" />
		<EmbeddedResource Remove="AutoMapperLite.Benchmarks\**" />
		<None Remove="AutoMapperLite.Tests\**" />
		<None Remove="AutoMapperLite.Benchmarks\**" />
	</ItemGroup>

</Project>