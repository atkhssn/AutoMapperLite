<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
		<!-- Comparison-only dependencies for the benchmark suite (dev tool, not shipped in the
		     packed library). Latest stable as of this writing. -->
		<PackageReference Include="AutoMapper" Version="16.2.0" />
		<PackageReference Include="Mapster" Version="10.0.12" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\AutoMapperLite.csproj" />
	</ItemGroup>

</Project>
